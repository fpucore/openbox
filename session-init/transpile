# --- Argument Parsing (corrected) ---
my $input-file;
my $output-file;

for @*ARGS -> $arg {
    if $arg.starts-with('--input=') {
        $input-file = $arg.substr(8);
    }
    elsif $arg.starts-with('--output=') {
        $output-file = $arg.substr(9);
    }
}

$input-file  //= die "Missing --input=<path>";
$output-file //= die "Missing --output=<path>";

# Expand ~ to $HOME manually (Raku does not auto-expand ~ in strings)
if $input-file.starts-with('~') {
    $input-file = %*ENV<HOME> ~ $input-file.substr(1);
}
if $output-file.starts-with('~') {
    $output-file = %*ENV<HOME> ~ $output-file.substr(1);
}

my $in-multiline-comment = False;
my $pending-lockfile = '';

say "[transpile] Reading legacy autostart from: $input-file";
my @lines = slurp($input-file).lines;

# Generated script header
my @generated = q:to/HEADER/.lines;
    #!/usr/bin/env raku
    use v6.d;
    # Auto-generated by session-init transpiler — DO NOT EDIT
    # Source: ~/.config/openbox/autostart
    
    sub log-msg(Str $msg) {
        my $ts = DateTime.now.Str;
        say "[$ts] $msg";
    }
    
    sub run-cmd(Str $cmd, Bool :$background = False, Int :$delay = 0) {
        sleep($delay) if $delay > 0;
        log-msg("Running: $cmd" ~ ($background ?? " (background)" !! ""));
        if $background {
            shell("$cmd &");
        } else {
            my $proc = shell($cmd);
            unless $proc.exitcode == 0 {
                log-msg("WARNING: Command exited with status {$proc.exitcode}: $cmd");
            }
        }
    }
    HEADER

# --- Scrapbook Parser ---
# NOTE: $in-multiline-comment and $pending-lockfile are declared at top of file

    for @lines -> $raw-line {
    my $line = $raw-line.trim;

    # Skip empty lines
    next if $line eq '';

    # Multi-line comment blocks
    if $line.starts-with('#>') { $in-multiline-comment = True; next }
    if $line.starts-with('<#') { $in-multiline-comment = False; next }
    next if $in-multiline-comment;

    # Skip all comments
    next if $line.starts-with('#');

    # Strip inline trailing comments
    $line = $line.subst(/\s+'#' .*$/, '').trim;
    next if $line eq '';

    # Normalize ~/ to $HOME/ for Raku compatibility and visual consistency
    $line = $line.subst(/'~/'/, '$HOME/', :g);

    # Skip redundant touch commands inside active lockfile guards
    if $pending-lockfile ne '' && $line ~~ /^ 'touch ' \s* (.+) $/ {
        my $touch-target = $0.trim;
        next if $touch-target eq $pending-lockfile;
    }

    # Use given/when to guarantee exactly ONE branch matches per line
    # Skip redundant touch commands inside active lockfile guards
    if $pending-lockfile ne '' && $line ~~ /^ 'touch ' \s* (.+) $/ {
        my $touch-target = $0.trim;
        next if $touch-target eq $pending-lockfile;
    }

    given $line {
        # Lockfile guard closing
        when 'fi' {
            if $pending-lockfile ne '' {
                @generated.append: '}';
                $pending-lockfile = '';
            }
        }

        # Lockfile guard opening
        when /^ 'if [ ! -f ' \s* (.+?) \s* ']; then' $/ {
            $pending-lockfile = $0.trim;
            @generated.append: "# Lockfile guard: $pending-lockfile";
            @generated.append: 'unless \'' ~ $pending-lockfile ~ '\'.IO.e {';
            @generated.append: '    shell(\'touch ' ~ $pending-lockfile ~ '\');';
        }

        # Backgrounded delay: (sleep N; cmd) &
        when /^ '(' \s* 'sleep' \s+ (\d+) \s* ';' \s+ (.+?) ')' \s* '&' $/ {
            my $delay = +$0;
            my $cmd   = $1.trim;
            my $indent = $pending-lockfile ne '' ?? '    ' !! '';
            @generated.append: $indent ~ 'run-cmd(\'' ~ $cmd ~ '\', :background, :delay(' ~ $delay ~ '));';
        }

        # Simple background: cmd &
        when /^(.+?) \s+ '&' $/ {
            my $cmd = $0.trim;
            my $indent = $pending-lockfile ne '' ?? '    ' !! '';
            @generated.append: $indent ~ 'run-cmd(\'' ~ $cmd ~ '\', :background);';
        }

        # Everything else: blocking foreground
        default {
            my $indent = $pending-lockfile ne '' ?? '    ' !! '';
            @generated.append: $indent ~ 'run-cmd(\'' ~ $line ~ '\');';
        }
    }
}

# Auto-close unclosed lockfile
if $pending-lockfile ne '' {
    @generated.append: '} # auto-closed unclosed lockfile guard';
}

# Write the generated script
spurt($output-file, @generated.join("\n") ~ "\n");
chmod(0o755, $output-file);
say "[transpile] Generated executable script at: $output-file";
